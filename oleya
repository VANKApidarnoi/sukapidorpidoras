				local indent = 0
				local function startNewLine()
					str = str .. "\n"
					str = str .. string.rep(" ", indent * tabWidth)
				end

				local len = #jsonStr
				for i = 1, len do
					local ch = jsonStr:sub(i, i)

					if ch == "{" or ch == "[" then
						str = str .. ch
						indent = indent + 1
						startNewLine()
					elseif ch == "}" or ch == "]" then
						indent = indent - 1
						startNewLine()
						str = str .. "}"
					elseif ch == ":" then
						str = str .. ": "
					elseif ch == "," then
						str = str .. ","
						startNewLine()
					else
						str = str .. ch
					end
				end

